" Enable auto file type detection
filetype on
" Enable plugin autoload for detected file types
filetype plugin on
" Load an indent file for the detected file type
filetype indent on

" Show line numbers
set number
set cursorline
set number

" Set default indentation
set tabstop=2
set softtabstop=2
set shiftwidth=2
set expandtab

" Set autoindentation
set autoindent

" Enable syntax highlighting
syntax on

